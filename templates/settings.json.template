{
  "defaultMode": "default",
  "permissions": {
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(Invoke-RestMethod:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(Get-ChildItem Env:*)",
      "Bash(powershell -Command:*)",
      "Bash(cmd /c:*)",
      "Bash(bash -c:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(*Local.*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout .:*)",
      "Bash(rm:*)",
      "Bash(Remove-Item:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -File C:/Users/<USER>/.claude/hooks/PreToolUse-DenyDangerous.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -File C:/Users/<USER>/.claude/hooks/PostToolUse-AutoCheckpoint.ps1"
          }
        ]
      }
    ]
  }
}
